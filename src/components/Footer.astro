---
const year = new Date().getFullYear();
const links = [
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/how-we-make-money', label: 'How We Make Money' },
  { href: '/privacy-policy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms' },
];
---

<footer class="border-t border-navy-700 bg-navy-950 text-charcoal-300">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      {
        links.map((link) => (
          <a href={link.href} class="hover:text-amber-500">
            {link.label}
          </a>
        ))
      }
      <button
        type="button"
        id="reopen-disclosure"
        class="cursor-pointer text-left hover:text-amber-500"
      >
        Advertiser Disclosure
      </button>
    </div>

    <p class="mt-6 max-w-3xl text-xs leading-relaxed text-charcoal-500">
      Card Compare is an independent publisher. Content on this site is educational and general
      in nature — it is not financial, legal, or tax advice, and it is not a recommendation to
      apply for any specific product. Credit card terms, rates, and fees change frequently and
      without notice; always confirm current terms directly with the issuer before applying.
    </p>

    <p class="mt-4 text-xs text-charcoal-500">© {year} Card Compare. All rights reserved.</p>
  </div>
</footer>

<script>
  document.getElementById('reopen-disclosure')?.addEventListener('click', () => {
    window.localStorage.removeItem('advertiser-disclosure-dismissed');
    document.getElementById('advertiser-disclosure-bar')?.classList.remove('hidden');
  });
</script>
