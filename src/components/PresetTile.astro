---
import type { PresetDef } from '../lib/finder';

interface Props {
  preset: PresetDef;
}

const { preset } = Astro.props;
---

<a
  href={`/finder/${preset.slug}`}
  class="block rounded-lg border border-charcoal-300/60 bg-white p-5 transition-colors hover:border-amber-600"
>
  <p class="font-serif-heading text-base font-semibold text-navy-900">{preset.shortLabel}</p>
</a>
