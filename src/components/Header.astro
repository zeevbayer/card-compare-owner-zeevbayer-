---
const nav = [
  { href: '/finder', label: 'Card Finder' },
  { href: '/offers', label: 'Offers' },
  { href: '/articles', label: 'Articles' },
  { href: '/how-we-make-money', label: 'How We Make Money' },
];
---

<header class="border-b border-navy-700 bg-navy-900 text-paper">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href="/" class="font-serif-heading text-xl font-semibold tracking-tight text-paper">
      Card Compare
    </a>
    <nav aria-label="Primary" class="hidden gap-6 text-sm md:flex">
      {
        nav.map((item) => (
          <a href={item.href} class="text-charcoal-300 transition-colors hover:text-amber-500">
            {item.label}
          </a>
        ))
      }
    </nav>
    <a
      href="/finder"
      class="rounded border border-amber-600 px-3 py-1.5 text-sm text-amber-500 transition-colors hover:bg-amber-600 hover:text-navy-950 md:hidden"
    >
      Finder
    </a>
  </div>
  <nav aria-label="Primary mobile" class="flex gap-4 overflow-x-auto px-4 pb-3 text-sm md:hidden">
    {
      nav.map((item) => (
        <a href={item.href} class="whitespace-nowrap text-charcoal-300 hover:text-amber-500">
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
