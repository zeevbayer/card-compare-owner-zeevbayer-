---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerifiedBadge from '../../components/VerifiedBadge.astro';
import AffiliateDisclosureNotice from '../../components/AffiliateDisclosureNotice.astro';
import { formatFee, formatApr, formatIntroApr } from '../../lib/format';
import { isUnverified } from '../../lib/verification';

export async function getStaticPaths() {
  const cards = await getCollection('cards');
  return cards.map((card) => ({ params: { slug: card.data.slug }, props: { card } }));
}

const { card } = Astro.props;
const d = card.data;
const isAffiliate = Boolean(d.affiliateUrl);
const applyHref = d.affiliateUrl ?? d.issuerUrl;
const introAprText = formatIntroApr(d.introApr, d.introAprMonths, d.isDeferredInterest);
const unverified = isUnverified(d.lastVerified);

const tierLabel: Record<string, string> = {
  excellent: 'Excellent credit',
  good: 'Good credit',
  fair: 'Fair credit',
  building: 'Building credit',
};

const { Content } = await render(card);
---

<BaseLayout
  title={`${d.name} Review`}
  description={`${d.name} from ${d.issuer}: annual fee, APR, rewards, and verified terms.`}
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <p class="text-sm text-charcoal-500">
      <a href="/finder" class="hover:text-amber-700">Card Finder</a> / {d.issuer}
    </p>
    <h1 class="font-serif-heading mt-2 text-3xl font-semibold text-navy-900">{d.name}</h1>
    <p class="mt-1 text-charcoal-500">{d.issuer}</p>

    <div class="mt-6">
      <AffiliateDisclosureNotice />
    </div>

    {
      unverified && (
        <p class="mt-6 rounded border border-amber-600 bg-amber-100 px-4 py-3 text-sm text-amber-700">
          We have not yet verified current terms for this card. Figures below may be incomplete.
          Confirm directly with the issuer before applying.
        </p>
      )
    }

    <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <VerifiedBadge lastVerified={d.lastVerified} />
      <a
        href={applyHref}
        target="_blank"
        rel={isAffiliate ? 'sponsored nofollow noopener' : 'noopener'}
        class="inline-block rounded border border-navy-900 px-5 py-2.5 text-center text-sm font-medium text-navy-900 transition-colors hover:bg-navy-900 hover:text-paper"
      >
        View at issuer
      </a>
    </div>

    <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-charcoal-300/60 pt-6 text-sm sm:grid-cols-3">
      <div>
        <dt class="text-xs text-charcoal-500">Annual fee</dt>
        <dd class="mt-0.5 font-medium text-charcoal-900">{formatFee(d.annualFee)}</dd>
      </div>
      <div>
        <dt class="text-xs text-charcoal-500">Purchase APR</dt>
        <dd class="mt-0.5 font-medium text-charcoal-900">{formatApr(d.purchaseAprMin, d.purchaseAprMax)}</dd>
      </div>
      <div>
        <dt class="text-xs text-charcoal-500">Credit needed</dt>
        <dd class="mt-0.5 font-medium text-charcoal-900">{tierLabel[d.creditScoreTier]}</dd>
      </div>
      <div>
        <dt class="text-xs text-charcoal-500">Balance transfer fee</dt>
        <dd class="mt-0.5 font-medium text-charcoal-900">
          {d.balanceTransferFee !== null ? `${d.balanceTransferFee}%` : 'Not listed'}
        </dd>
      </div>
      <div>
        <dt class="text-xs text-charcoal-500">Foreign transaction fee</dt>
        <dd class="mt-0.5 font-medium text-charcoal-900">
          {d.foreignTransactionFee !== null ? `${d.foreignTransactionFee}%` : 'Not listed'}
        </dd>
      </div>
      <div>
        <dt class="text-xs text-charcoal-500">Signup bonus</dt>
        <dd class="mt-0.5 font-medium text-charcoal-900">{d.signupBonus ?? 'Not listed'}</dd>
      </div>
    </dl>

    {
      introAprText && (
        <p class="mt-6 rounded bg-paper-dim px-4 py-3 text-sm text-charcoal-700">{introAprText}</p>
      )
    }

    {
      d.signupBonus && (d.signupBonusSpend !== null || d.signupBonusWindow) && (
        <p class="mt-3 text-sm text-charcoal-600">
          Requires {d.signupBonusSpend !== null ? `$${d.signupBonusSpend} in spend` : 'qualifying spend'}
          {d.signupBonusWindow ? ` within ${d.signupBonusWindow}` : ''}.
        </p>
      )
    }

    {
      d.rewardsStructure && (
        <div class="mt-8 border-t border-charcoal-300/60 pt-6">
          <h2 class="font-serif-heading text-lg font-semibold text-navy-900">Rewards structure</h2>
          <p class="mt-2 text-charcoal-700">{d.rewardsStructure}</p>
        </div>
      )
    }

    <div class="prose prose-sm mt-8 max-w-none border-t border-charcoal-300/60 pt-6 text-charcoal-700">
      <Content />
    </div>

    <p class="mt-8 text-xs text-charcoal-500">
      Categories: {d.categories.join(', ') || 'None listed'}
    </p>
  </div>
</BaseLayout>
