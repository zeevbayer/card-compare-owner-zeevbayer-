---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardResult from '../../components/CardResult.astro';
import FinderFilters from '../../components/FinderFilters.astro';
import AffiliateDisclosureNotice from '../../components/AffiliateDisclosureNotice.astro';
import { eligibleCards, parseFinderParams } from '../../lib/finder';
import { slugify } from '../../lib/slugify';

const allCards = await getCollection('cards');
const cards = eligibleCards(allCards).sort((a, b) => a.data.name.localeCompare(b.data.name));

const issuerMap = new Map<string, string>();
for (const card of cards) {
  issuerMap.set(slugify(card.data.issuer), card.data.issuer);
}
const issuers = [...issuerMap.entries()]
  .map(([slug, label]) => ({ slug, label }))
  .sort((a, b) => a.label.localeCompare(b.label));

// Empty default filters — the client script syncs actual state from location.search on load,
// since this page is static and the same HTML is served for every query string combination.
const emptyFilters = parseFinderParams(new URLSearchParams());

function bonusAmount(signupBonus: string | null): number {
  if (!signupBonus) return -1;
  const match = signupBonus.replace(/,/g, '').match(/\d+(\.\d+)?/);
  return match ? Number(match[0]) : -1;
}
---

<BaseLayout
  title="Credit Card Finder"
  description="Filter and compare credit cards by annual fee, credit score tier, category, and intro APR. Every combination of filters produces a shareable link."
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <h1 class="font-serif-heading text-3xl font-semibold text-navy-900">Credit Card Finder</h1>
    <p class="mt-2 max-w-2xl text-charcoal-700">
      Filter by category, annual fee, credit score tier, issuer, and intro APR. Every filter
      combination has its own link, so you can bookmark or share exactly what you filtered for.
      Cards with no verified terms on file are excluded until we confirm them.
    </p>

    <div class="mt-6">
      <AffiliateDisclosureNotice />
    </div>

    <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-[280px_1fr]">
      <aside>
        <FinderFilters filters={emptyFilters} issuers={issuers} />
      </aside>

      <div>
        <p id="result-count" class="mb-4 text-sm text-charcoal-500" aria-live="polite">
          {cards.length} cards
        </p>

        <div id="results" class="space-y-4">
          {
            cards.map((card) => (
              <div
                data-card
                data-name={card.data.name}
                data-category={card.data.categories.join(' ')}
                data-fee={card.data.annualFee ?? ''}
                data-tier={card.data.creditScoreTier}
                data-issuer={slugify(card.data.issuer)}
                data-intro-apr={card.data.introApr !== null ? 'true' : 'false'}
                data-intro-apr-months={card.data.introAprMonths ?? -1}
                data-bonus-amount={bonusAmount(card.data.signupBonus)}
              >
                <CardResult card={card} />
              </div>
            ))
          }
        </div>

        <p id="no-results" class="hidden text-charcoal-600">
          No cards match those filters. Try widening your search.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  type Filters = {
    category: string | null;
    feeMax: number | null;
    tier: string[];
    issuer: string[];
    introApr: boolean;
    sort: string | null;
    dir: 'asc' | 'desc';
  };

  function parseFilters(search: string): Filters {
    const params = new URLSearchParams(search);
    const multi = (key: string) => params.getAll(key).flatMap((v) => v.split(',')).filter(Boolean);
    const feeMaxRaw = params.get('feeMax');
    return {
      category: params.get('category') || null,
      feeMax: feeMaxRaw !== null && feeMaxRaw !== '' ? Number(feeMaxRaw) : null,
      tier: multi('tier'),
      issuer: multi('issuer'),
      introApr: params.get('introApr') === 'true',
      sort: params.get('sort') || null,
      dir: params.get('dir') === 'desc' ? 'desc' : 'asc',
    };
  }

  function syncForm(filters: Filters) {
    const form = document.querySelector<HTMLFormElement>('form[action="/finder"]');
    if (!form) return;
    const categoryEl = form.elements.namedItem('category') as HTMLSelectElement | null;
    if (categoryEl) categoryEl.value = filters.category ?? '';
    const feeMaxEl = form.elements.namedItem('feeMax') as HTMLSelectElement | null;
    if (feeMaxEl) feeMaxEl.value = filters.feeMax !== null ? String(filters.feeMax) : '';
    const sortEl = form.elements.namedItem('sort') as HTMLSelectElement | null;
    if (sortEl) sortEl.value = filters.sort ?? '';
    const dirEl = form.elements.namedItem('dir') as HTMLSelectElement | null;
    if (dirEl) dirEl.value = filters.dir;
    form.querySelectorAll<HTMLInputElement>('input[name="tier"]').forEach((el) => {
      el.checked = filters.tier.includes(el.value);
    });
    form.querySelectorAll<HTMLInputElement>('input[name="issuer"]').forEach((el) => {
      el.checked = filters.issuer.includes(el.value);
    });
    const introAprEl = form.querySelector<HTMLInputElement>('input[name="introApr"]');
    if (introAprEl) introAprEl.checked = filters.introApr;
  }

  function applyFilters() {
    const filters = parseFilters(window.location.search);
    syncForm(filters);

    const container = document.getElementById('results');
    if (!container) return;
    const cards = Array.from(container.querySelectorAll<HTMLElement>('[data-card]'));

    let visibleCount = 0;
    for (const el of cards) {
      let visible = true;
      if (filters.category && !el.dataset.category?.split(' ').includes(filters.category)) {
        visible = false;
      }
      if (filters.feeMax !== null) {
        const fee = el.dataset.fee;
        if (fee === '' || fee === undefined || Number(fee) > filters.feeMax) visible = false;
      }
      if (filters.tier.length && !filters.tier.includes(el.dataset.tier ?? '')) {
        visible = false;
      }
      if (filters.issuer.length && !filters.issuer.includes(el.dataset.issuer ?? '')) {
        visible = false;
      }
      if (filters.introApr && el.dataset.introApr !== 'true') {
        visible = false;
      }
      el.classList.toggle('hidden', !visible);
      if (visible) visibleCount++;
    }

    if (filters.sort) {
      const dirMultiplier = filters.dir === 'desc' ? -1 : 1;
      const key =
        filters.sort === 'annual-fee'
          ? 'fee'
          : filters.sort === 'intro-apr-length'
            ? 'introAprMonths'
            : 'bonusAmount';
      const sorted = [...cards].sort((a, b) => {
        const av = Number(a.dataset[key] || (key === 'fee' ? Infinity : -1));
        const bv = Number(b.dataset[key] || (key === 'fee' ? Infinity : -1));
        return (av - bv) * dirMultiplier;
      });
      sorted.forEach((el) => container.appendChild(el));
    }

    const countEl = document.getElementById('result-count');
    if (countEl) countEl.textContent = `${visibleCount} card${visibleCount === 1 ? '' : 's'}`;

    const noResultsEl = document.getElementById('no-results');
    if (noResultsEl) noResultsEl.classList.toggle('hidden', visibleCount !== 0);
  }

  applyFilters();
</script>
