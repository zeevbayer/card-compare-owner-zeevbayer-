---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardResult from '../../components/CardResult.astro';
import AffiliateDisclosureNotice from '../../components/AffiliateDisclosureNotice.astro';
import { eligibleCards, filterCards, sortCards, PRESETS } from '../../lib/finder';

export async function getStaticPaths() {
  return PRESETS.map((preset) => ({ params: { preset: preset.slug }, props: { preset } }));
}

const { preset } = Astro.props;
const allCards = await getCollection('cards');
const cards = sortCards(filterCards(eligibleCards(allCards), preset.filters), preset.filters.sort, preset.filters.dir);
---

<BaseLayout
  title={preset.title}
  description={preset.intro}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="text-sm text-charcoal-500">
      <a href="/finder" class="hover:text-amber-700">Card Finder</a> / {preset.shortLabel}
    </p>
    <h1 class="font-serif-heading mt-2 text-3xl font-semibold text-navy-900">{preset.title}</h1>
    <p class="mt-3 max-w-2xl text-charcoal-700">{preset.intro}</p>

    <div class="mt-6">
      <AffiliateDisclosureNotice />
    </div>

    <p class="mt-8 mb-4 text-sm text-charcoal-500">{cards.length} cards</p>

    <div class="space-y-4">
      {cards.map((card) => <CardResult card={card} />)}
    </div>

    {
      cards.length === 0 && (
        <p class="text-charcoal-600">
          No verified cards currently match this preset. Check back once we have verified terms
          on file, or browse the full <a href="/finder" class="text-amber-700 underline">finder</a>.
        </p>
      )
    }

    <p class="mt-10 text-sm">
      <a href="/finder" class="text-amber-700 underline hover:text-amber-600">
        See all filters in the full card finder →
      </a>
    </p>
  </div>
</BaseLayout>
