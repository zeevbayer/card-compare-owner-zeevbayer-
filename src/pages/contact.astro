---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with Card Compare.">
  <div class="mx-auto max-w-2xl px-4 py-10 sm:px-6">
    <h1 class="font-serif-heading text-3xl font-semibold text-navy-900">Contact</h1>
    <div class="prose prose-slate mt-6 max-w-none">
      <p>
        Spotted an error, an out-of-date figure, or a card that needs re-verifying? We'd rather
        hear about it than have a stale number sit on the site.
      </p>
      <p>
        Email: <a href="mailto:hello@cardcompare.example.com">hello@cardcompare.example.com</a>
      </p>
      <p class="text-sm text-charcoal-500">Replace with a real inbox before launch.</p>
    </div>
  </div>
</BaseLayout>
