---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PresetTile from '../components/PresetTile.astro';
import { PRESETS } from '../lib/finder';
import { SITE_TAGLINE } from '../lib/seo';

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<BaseLayout
  title="Card Compare"
  description="An analytical, independent read on credit card terms — deferred interest, real APRs, and fee structures, explained in plain numbers."
>
  <section class="border-b border-charcoal-300/60 bg-paper-dim">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6">
      <h1 class="font-serif-heading text-4xl font-semibold text-navy-900 sm:text-5xl">
        Read the terms before the card reads you.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-charcoal-700">
        {SITE_TAGLINE} Most comparison sites are built to sell you a card. We start from the
        assumption that most people don't understand what they're signing up for — and try to fix
        that, one card at a time.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href="/finder"
          class="rounded bg-navy-900 px-5 py-3 text-sm font-medium text-paper hover:bg-navy-800"
        >
          Open the card finder
        </a>
        <a
          href="/articles"
          class="rounded border border-navy-900 px-5 py-3 text-sm font-medium text-navy-900 hover:bg-navy-900 hover:text-paper"
        >
          Read the articles
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <h2 class="font-serif-heading text-2xl font-semibold text-navy-900">Find a card by what matters to you</h2>
    <p class="mt-2 max-w-2xl text-charcoal-700">
      Each preset below is its own page with only the cards that fit — no login, no email
      required to see results.
    </p>
    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      {PRESETS.map((preset) => <PresetTile preset={preset} />)}
    </div>
  </section>

  <section class="border-t border-charcoal-300/60 bg-paper-dim">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="flex items-baseline justify-between">
        <h2 class="font-serif-heading text-2xl font-semibold text-navy-900">Latest articles</h2>
        <a href="/articles" class="text-sm text-amber-700 underline hover:text-amber-600">View all</a>
      </div>
      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          articles.map((article) => (
            <article class="rounded-lg border border-charcoal-300/60 bg-white p-5">
              <p class="text-xs uppercase tracking-wide text-charcoal-500">
                {article.data.category} · {formatDate(article.data.publishDate)}
              </p>
              <h3 class="font-serif-heading mt-1 text-lg font-semibold text-navy-900">
                <a href={`/articles/${article.id}`} class="hover:text-amber-700">
                  {article.data.title}
                </a>
              </h3>
              <p class="mt-2 text-sm text-charcoal-700">{article.data.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
